NODE_ENV=development
PORT=3001
DATABASE_URL=            # POOLED Neon string for the running API
DATABASE_URL_DIRECT=     # DIRECT Neon string for migrate, seed and create-admin
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=       # at least 32 random characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SAME_SITE=lax     # "none" only if the site and API are on different domains (needs Secure)
BCRYPT_COST=12